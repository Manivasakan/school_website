# --- Database (Neon pooled connection string) ---
# Get from https://console.neon.tech/ → your project → Connection string → "Pooled connection"
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DBNAME?sslmode=require"

# --- NextAuth (Auth.js v5) ---
# Generate with PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object {Get-Random -Maximum 256}))
AUTH_SECRET=""
# Local dev: http://localhost:3000    Production: https://yourschool.com
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- Cloudflare R2 (S3-compatible storage for images + downloads) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="school-media"
# Public URL where uploaded files are served. Use R2 public bucket URL or custom domain.
R2_PUBLIC_URL="https://pub-XXXXX.r2.dev"

# --- Cloudflare Turnstile (free anti-spam) ---
# Server reads TURNSTILE_SECRET_KEY; client reads NEXT_PUBLIC_TURNSTILE_SITE_KEY.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Brevo email (HTTP API; works on Cloudflare Workers) ---
# https://app.brevo.com/ → SMTP & API → API keys → "Create a new API key"
BREVO_API_KEY=""
# "From" address for outgoing email. Must be a verified Brevo sender or domain.
SMTP_FROM="no-reply@yourschool.com"

# --- Initial seed data (used by prisma db seed on first run) ---
SEED_ADMIN_EMAIL="admin@school.lk"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
SEED_ADMIN_NAME="Super Admin"
SEED_SCHOOL_NAME="Jaffna Government School"
SEED_SCHOOL_SHORT="JGS"
